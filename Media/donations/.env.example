# Square donations — copy values to S:/projects/FutureFoundations/.env (local)
# and Netlify Site settings → Environment variables (production).
# Dashboard: https://app.squareup.com/dashboard

FUTURE_FOUNDATIONS_ROOT=S:/projects/FutureFoundations
SQUARE_ENVIRONMENT=production
# production: https://connect.squareup.com
# sandbox:    https://connect.squareupsandbox.com

SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_APPLICATION_ID=

# Optional: protect POST /api/square-donate/create-link
SQUARE_ADMIN_KEY=

# Public payment link URLs (paste after dashboard or script create)
SQUARE_LINK_CUSTOM=
SQUARE_LINK_SUPPORTER_5=
SQUARE_LINK_DEFENDER_25=
SQUARE_LINK_GUARDIAN_50=
SQUARE_LINK_PROTECTOR_100=

# Redirect after successful checkout
SQUARE_DONATE_REDIRECT_URL=https://futurefoundationspac.org/donate/thank-you
