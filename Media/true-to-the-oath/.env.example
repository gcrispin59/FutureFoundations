# Future Foundations media publishing — copy to .env and fill in values.
# Never commit .env to git.

FUTURE_FOUNDATIONS_ROOT=S:/projects/FutureFoundations
MEDIA_ARCHIVE_ROOT=S:/AI Artifacts/media-archive

# Optional: override bundled ffmpeg
# FFMPEG_PATH=

# YouTube Data API (for upload_youtube_short.py)
# Create OAuth client: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
