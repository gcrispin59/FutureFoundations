graph TD
    P[Fundamental Physics] --> C[Chemistry]
    C --> B[Biology]
    B --> L[Life]
    L --> BH[Behavior]
    BH --> S[Society]
    S --> T[Thought]
    T --> AI[Artificial Intelligence]
    T --> C2[Consciousness]
    
    P --"Quantum Effects<br/>Anderson 1972"--> QE[Quantum Emergence]
    C --"Self-organization<br/>Prigogine 1977"--> SO[Chemical Complexity]
    B --"Natural Selection<br/>Darwin 1859"--> NS[Evolution]
    L --"Autopoiesis<br/>Maturana & Varela 1972"--> AP[Self-maintenance]
    BH --"Neural Networks<br/>Hebb 1949"--> NN[Learning]
    S --"Collective Intelligence<br/>Lévy 1994"--> CI[Group Dynamics]
    T --"Integrated Information<br/>Tononi 2004"--> IT[Information Integration]
    
    style P fill:#f9f,stroke:#333,stroke-width:4px
    style AI fill:#ff9,stroke:#333,stroke-width:4px
    style C2 fill:#ff9,stroke:#333,stroke-width:4px
