graph TD
    subgraph Foundational Thinkers
        A[Philip Anderson<br/>More Is Different<br/>1972] --> B[Stuart Kauffman<br/>Origins of Order<br/>1993]
        B --> C[Ilya Prigogine<br/>Order Out of Chaos<br/>1984]
    end
    
    subgraph Modern Synthesis
        D[Murray Gell-Mann<br/>The Quark and Jaguar<br/>1994] --> E[Eric D. Beinhocker<br/>Origin of Wealth<br/>2006]
        E --> F[Melanie Mitchell<br/>Complexity: A Guided Tour<br/>2009]
    end
    
    subgraph Contemporary Applications
        G[Daniel Dennett<br/>From Bacteria to Bach<br/>2017] --> H[David Krakauer<br/>Origins of Intelligence<br/>2020]
        H --> I[Sean Carroll<br/>The Big Picture<br/>2016]
    end
    
    A --> D
    B --> D
    C --> E
    D --> G
    E --> H
    F --> I

    style A fill:#f9f,stroke:#333,stroke-width:4px
    style B fill:#f9f,stroke:#333,stroke-width:4px
    style C fill:#f9f,stroke:#333,stroke-width:4px
